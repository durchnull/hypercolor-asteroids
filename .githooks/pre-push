#!/bin/sh
# GR7, the part of it that only shows up at push time: the history is the
# scoreboard, and you do not get to edit the scoreboard. Your own branches are
# yours to rebase; main belongs to everyone.
set -u
Z=0000000000000000000000000000000000000000
status=0
pushing_main=0

while read -r _local lsha rref rsha; do
  case "$rref" in refs/heads/main|refs/heads/master) pushing_main=1 ;; *) continue ;; esac

  if [ "$lsha" = "$Z" ]; then
    printf '\n  GR7  refusing to delete %s. that is everybody'\''s history.\n\n' "$rref" >&2
    status=1
    continue
  fi
  [ "$rsha" = "$Z" ] && continue

  if ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
    printf '\n  GR7  this push rewrites %s - commits that other pilots already have\n' "$rref" >&2
    printf '       would disappear. Land a new commit instead; the old one stays\n' >&2
    printf '       in the book either way.\n\n' >&2
    status=1
  fi
done

# The ground crew, whose paperwork lands on main while people are flying. The
# remote would refuse this push anyway and say so in git's own words; this says
# it in the cabinet's, and names the one command that clears it.
#
# It only ever reports. Rewriting the branch from inside a hook the pilot did
# not aim at their own history would be a worse habit than the one it saves -
# and it cannot work regardless, because git resolved the sha it is pushing
# before this ran.
if [ "$pushing_main" = 1 ] && [ "$status" = 0 ] && [ -f tools/groundcrew.sh ]; then
  if ! out=$(sh tools/groundcrew.sh --check 2>&1); then
    printf '%s\n' "$out" >&2
    status=1
  fi
fi

exit $status
