#!/bin/sh
# Two jobs, in this order, because the second one has to see the finished tree.
#
# First the notes. docs/ carries a rendered copy of every markdown note this
# project keeps, and a copy that disagrees with its source is worse than no
# copy at all - so when a commit moves any markdown, or moves the tool that
# renders it, the pages are rebuilt from what is staged and land in the same
# commit as the words they came from. Only the pages that actually came out
# different are written; a commit that touches no markdown never runs this.
#
# Then the red lines. Six rules that nobody gets to override, checked against
# what is staged, before the message is even written. See GOLDEN_RULES.md.
set -u
ROOT=$(git rev-parse --show-toplevel) || exit 0
cd "$ROOT" || exit 0

if git diff --cached --name-only --diff-filter=ACMR |
   grep -Eq '\.md$|^tools/docs\.sh$'; then
  if ! REBUILT=$(sh tools/docs.sh --staged); then
    printf '\n  the notes did not rebuild, so nothing was committed.\n' >&2
    printf '  tools/docs.sh --staged says why.\n\n' >&2
    exit 1
  fi
  printf '%s\n' "$REBUILT"

  # Only the pages that came out different join the commit. The second list is
  # for the first time this ever runs, or for a note somebody generated by hand
  # before committing: a page git has never seen still has to be added, even
  # though rendering it changed nothing.
  {
    printf '%s\n' "$REBUILT" | sed -n 's/^wrote //p'
    sh tools/docs.sh --list | while IFS= read -r n; do
      if [ -f "$n" ] && ! git ls-files --error-unmatch -- "$n" >/dev/null 2>&1; then
        printf '%s\n' "$n"
      fi
    done
  } | sort -u | while IFS= read -r note; do
    if [ -n "$note" ]; then git add -- "$note"; fi
  done
fi

exec tools/golden-check.sh --staged --stage pre-commit
