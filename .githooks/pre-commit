#!/bin/sh
# Two jobs, in this order, because the second one has to see the finished tree.
#
# First the notes. docs/ carries a rendered copy of every markdown note this
# project keeps, and a copy that disagrees with its source is worse than no
# copy at all - so when a commit moves any markdown, or moves the tool that
# renders it, the pages are rebuilt from what is staged and land in the same
# commit as the words they came from. Only the pages that actually came out
# different are written; a commit that touches no markdown never runs this.
#
# Then the red lines. Seven rules that nobody gets to override, checked against
# what is staged, before the message is even written. See GOLDEN_RULES.md.
set -u
ROOT=$(git rev-parse --show-toplevel) || exit 0
cd "$ROOT" || exit 0

if git diff --cached --name-only --diff-filter=ACMR |
   grep -Eq '\.md$|^tools/docs\.sh$'; then
  if ! REBUILT=$(sh tools/docs.sh --staged); then
    printf '\n  the notes did not rebuild, so nothing was committed.\n' >&2
    printf '  tools/docs.sh --staged says why.\n\n' >&2
    exit 1
  fi
  printf '%s\n' "$REBUILT"

  # Only the pages that came out different join the commit. The second list is
  # for the first time this ever runs, or for a note somebody generated by hand
  # before committing: a page git has never seen still has to be added, even
  # though rendering it changed nothing.
  {
    printf '%s\n' "$REBUILT" | sed -n 's/^wrote //p'
    sh tools/docs.sh --list | while IFS= read -r n; do
      if [ -f "$n" ] && ! git ls-files --error-unmatch -- "$n" >/dev/null 2>&1; then
        printf '%s\n' "$n"
      fi
    done
  } | sort -u | while IFS= read -r note; do
    if [ -n "$note" ]; then git add -- "$note"; fi
  done
fi

# Nothing checks the referee except this, so it runs when the referee moves -
# golden-check.sh itself, its own tests, and the two tools it leans on to
# decide what is generated and what the ledger should say. And nothing checks
# the sentence except tools/tally-test.sh - what a bend costs, who a breach
# charges, the receipts these hooks write, what the ledger does to a pilot's
# field, and whether tools/lockstep.sh still objects when a reader of "is this
# a version" is bent - so that one runs when any of that machinery moves. Each
# suite takes a minute or two, which is why neither is on the path of an
# ordinary landing.
if git diff --cached --name-only --diff-filter=ACMRD |
   grep -Eq '^tools/(golden-check|referee-test|tally|docs)\.sh$'; then
  if ! sh tools/referee-test.sh; then
    printf '\n  the referee no longer referees. nothing was committed.\n' >&2
    printf '  tools/referee-test.sh says which rule stopped working.\n\n' >&2
    exit 1
  fi
fi

if git diff --cached --name-only --diff-filter=ACMRD |
   grep -Eq '^tools/(tally|tally-test|chronicle|lockstep)\.sh$|^\.githooks/|^src/game/(tally|events)\.js$'; then
  if ! sh tools/tally-test.sh; then
    printf '\n  a bend no longer costs what the rules say. nothing was committed.\n' >&2
    printf '  tools/tally-test.sh says which part of the sentence stopped landing.\n\n' >&2
    exit 1
  fi
fi

exec tools/golden-check.sh --staged --stage pre-commit
