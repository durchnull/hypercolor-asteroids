# macOS
.DS_Store

# Local developer notebook — notes on the game behind the game, per machine,
# never part of the cabinet.
.dev/

# Playwright MCP scratch output (screenshots, console logs, snapshots)
.playwright-mcp/

# Local Claude Code settings
.claude/settings.local.json

# What this machine has asked Claude to watch for. Local, like the notebook it
# writes into — and the sabotage axis keeps an index of open holes, which is
# not a thing to publish to the room it describes.
.claude/observe/

# Credentials, and the one file in here that must never be committed. Only
# tools/chronicle-art.sh reads it, only on the machine of whoever is writing
# the book, and nothing in the game has ever heard of it. See .env.example.
.env
.env.*
!.env.example

# Your seat. Written by tools/whoami.sh from your git identity, local to your
# machine — if this ever got committed, everybody would inherit your seat and
# stop being ambushed by your events.
src/game/whoami.local.js
