{
  "permissions": {
    "allow": [
      "Bash(bash tools/golden-check.sh:*)",
      "Bash(git check-ignore:*)",
      "Bash(git config core.hooksPath)",
      "Bash(python3 -m http.server:*)",
      "Bash(sh tools/blackbox.sh:*)",
      "Bash(sh tools/chronicle.sh:*)",
      "Bash(sh tools/docs.sh:*)",
      "Bash(sh tools/export.sh:*)",
      "Bash(sh tools/golden-check.sh:*)",
      "Bash(sh tools/session-brief.sh:*)",
      "Bash(sh tools/tagline.sh:*)",
      "Bash(sh tools/tally.sh:*)",
      "Bash(sh tools/whoami.sh:*)",
      "Bash(tools/blackbox.sh:*)",
      "Bash(tools/chronicle.sh:*)",
      "Bash(tools/docs.sh:*)",
      "Bash(tools/export.sh:*)",
      "Bash(tools/golden-check.sh:*)",
      "Bash(tools/session-brief.sh:*)",
      "Bash(tools/tagline.sh:*)",
      "Bash(tools/tally.sh:*)",
      "Bash(tools/whoami.sh:*)",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_close",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_wait_for",
      "Skill(blackbox)",
      "Skill(chronicle)",
      "Skill(event)",
      "Skill(fairplay)",
      "Skill(land)",
      "Skill(referee)",
      "Skill(scout)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/session-brief.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/golden-check.sh --json",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
